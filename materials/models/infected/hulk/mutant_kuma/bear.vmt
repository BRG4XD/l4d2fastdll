"VertexLitGeneric"
{
    "$basetexture" "models/infected/hulk/mutant_kuma/Bear_Albedo"
    "$bumpmap"     "models/infected/hulk/mutant_kuma/Bear_Normal"
	"$detail" "models/infected/common/l4d2/ci_burning"

    "$surfaceprop" "flesh"

    "$phong" "1"
    "$phongboost" "1"
    "$phongexponent" "60"
    "$phongfresnelranges" "[0.05 0.25 0.5]"
	
	"$rimlight" "1"
    "$rimlightexponent" "3"
    "$rimlightboost" "0.5"
	
	"$allowdiffusemodulation" "1"
    "$halflambert" "1"

	"$bbqamount" "1"
    "$burnlevel" "0"

    "Proxies"
    {
        "BBQLevel"
        {
            "resultVar" "$bbqamount"
        }
        "BurnLevel"
        {
            "resultVar" "$burnlevel"
        }
        "Multiply"
        {
            "srcVar1" "$phongboost" 
            "srcVar2" "$bbqamount"
            "resultVar" "$phongboost"
        }
        "Equals"
        {
            "srcVar1" "$burnlevel"
            "resultVar" "$detailblendfactor"
        }
    }	
}